    class LilTosi {
        <<abstract>>
        +HeldAbility
        +ReleasedAbility
        +Controller EntityController
        +BeHeld(Transform parent)
        +BeThrown(Vector3 velocity)
        +GetAbsorbed()
    }
    class TipiTosi {
        Held: Teleport
        Released: Possession
    }
    class TenseTosi {
        Held: SlowTime
        Released: Explosion
    }
